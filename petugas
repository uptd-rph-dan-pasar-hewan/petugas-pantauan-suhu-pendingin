<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Petugas Input Suhu - UPTD RPH dan Pasar Hewan</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- jsPDF & AutoTable untuk Cetak PDF Rapi Tanpa Terpotong -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <style>
        html, body {
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }
        body {
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        @media (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }
        .sidebar-link-active {
            background-color: #0284c7;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
        }
        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        /* ==================== ANIMASI NOTIFIKASI DATA TERKIRIM ==================== */
        @keyframes notifPopIn {
            0% {
                opacity: 0;
                transform: scale(0.82) translateY(16px);
            }
            65% {
                opacity: 1;
                transform: scale(1.03) translateY(-2px);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }
        @keyframes notifPopOut {
            0% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
            100% {
                opacity: 0;
                transform: scale(0.9) translateY(10px);
            }
        }
        @keyframes pulseRing {
            0% {
                transform: scale(0.85);
                opacity: 0.7;
            }
            100% {
                transform: scale(1.55);
                opacity: 0;
            }
        }
        @keyframes drawCircle {
            0% {
                stroke-dashoffset: 166;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }
        @keyframes drawCheck {
            0% {
                stroke-dashoffset: 48;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }
        @keyframes progressShrink {
            0% {
                width: 100%;
            }
            100% {
                width: 0%;
            }
        }
        .anim-notif-in {
            animation: notifPopIn 0.42s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        .anim-notif-out {
            animation: notifPopOut 0.24s ease-in forwards;
        }
        .anim-pulse-ring {
            animation: pulseRing 1.3s cubic-bezier(0.22, 1, 0.36, 1) infinite;
        }
        .svg-check-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            animation: drawCircle 0.55s cubic-bezier(0.65, 0, 0.45, 1) 0.1s forwards;
        }
        .svg-check-mark {
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: drawCheck 0.35s cubic-bezier(0.65, 0, 0.45, 1) 0.48s forwards;
        }
        .anim-progress-bar {
            animation: progressShrink 3.5s linear forwards;
        }
    </style>
</head>
<body class="bg-white text-slate-800 antialiased min-h-screen overflow-hidden">

    <!-- ==================== HALAMAN LOGIN PILIH UNIT (TERKUNCI TANPA SCROLL) ==================== -->
    <div id="login-screen" class="fixed inset-0 h-dvh w-full overflow-hidden touch-none bg-gradient-to-br from-sky-950 via-slate-900 to-cyan-950 flex items-center justify-center p-4 z-50">
        <div class="w-full max-w-lg max-h-[calc(100dvh-2rem)] bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col">
            <div class="bg-gradient-to-r from-sky-900 via-sky-800 to-cyan-800 px-6 py-6 text-center text-white shrink-0">
                <img id="login-logo"
                    src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0%25' stop-color='%230284c7'/%3E%3Cstop offset='100%25' stop-color='%2306b6d4'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='url(%23g)'/%3E%3Cpath d='M32 10v44M13 21l38 22M51 21L13 43' stroke='%23ffffff' stroke-width='3.5' stroke-linecap='round'/%3E%3Ccircle cx='32' cy='32' r='7' fill='%230f172a' stroke='%23ffffff' stroke-width='3'/%3E%3C/svg%3E"
                    alt="Logo UPTD RPH dan Pasar Hewan"
                    class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl object-cover border-2 border-white/30 bg-white mx-auto shadow-lg">
                <h1 class="text-base sm:text-lg font-black uppercase tracking-wide mt-3.5 leading-snug">
                    UPTD RPH DAN PASAR HEWAN
                </h1>
                <p class="text-xs text-cyan-200 font-semibold mt-1">
                    Petugas Input Suhu Pendingin
                </p>
            </div>

            <div class="p-5 sm:p-8 text-center space-y-4 overflow-hidden">
                <div>
                    <h2 class="text-sm sm:text-base font-bold text-slate-800">Pilih Unit untuk Masuk</h2>
                    <p class="text-xs text-slate-500 mt-1">Klik salah satu unit terdaftar di bawah ini</p>
                </div>

                <!-- Tombol Unit Terdaftar Sejajar (misal RPH dan RPU) -->
                <div id="login-unit-buttons" class="flex flex-wrap items-center justify-center gap-3">
                    <span class="text-xs text-slate-400">Memuat daftar unit...</span>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-center gap-2 text-[11px] text-slate-400">
                    <span id="login-sync-status">Menghubungkan ke database...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== SHELL APLIKASI UTAMA (MUNCUL SETELAH PILIH UNIT) ==================== -->
    <div id="app-shell" class="hidden min-h-screen w-full flex">

        <!-- OVERLAY SIDEBAR (MOBILE) -->
        <div id="sidebar-overlay" onclick="setSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-[1px] z-40 hidden lg:hidden transition-opacity"></div>

        <!-- SIDEBAR NAVIGASI PETUGAS -->
        <aside id="app-sidebar"
            class="fixed inset-y-0 left-0 z-50 w-72 shrink-0 bg-slate-900 text-slate-200 flex flex-col justify-between shadow-2xl transition-all duration-300 ease-in-out -translate-x-full lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
            
            <div class="flex flex-col flex-1 overflow-y-auto">
                <!-- Header Sidebar dengan Logo + Tombol Tutup -->
                <div class="px-4 py-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <img id="sidebar-logo"
                            src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0%25' stop-color='%230284c7'/%3E%3Cstop offset='100%25' stop-color='%2306b6d4'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='url(%23g)'/%3E%3Cpath d='M32 10v44M13 21l38 22M51 21L13 43' stroke='%23ffffff' stroke-width='3.5' stroke-linecap='round'/%3E%3Ccircle cx='32' cy='32' r='7' fill='%230f172a' stroke='%23ffffff' stroke-width='3'/%3E%3C/svg%3E"
                            alt="Logo UPTD RPH dan Pasar Hewan"
                            class="w-10 h-10 rounded-xl object-cover border border-sky-400/40 bg-white shrink-0">
                        <div class="min-w-0">
                            <p class="text-[11px] font-black tracking-wide text-white uppercase leading-snug">Petugas Input Suhu</p>
                            <p class="text-[10px] text-cyan-300 font-semibold leading-snug">UPTD RPH &amp; Pasar Hewan</p>
                        </div>
                    </div>
                    <button type="button" onclick="setSidebar(false)" title="Tutup Menu"
                        class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Unit Login Aktif -->
                <div class="px-4 py-3 border-b border-slate-800/80 bg-sky-950/60 flex items-center justify-between text-[11px]">
                    <span class="text-slate-300 font-medium">Unit Aktif</span>
                    <span id="sidebar-unit-aktif" class="text-[11px] font-black px-2.5 py-0.5 rounded-full bg-sky-500/20 text-cyan-300 border border-sky-400/40">
                        -
                    </span>
                </div>

                <!-- Status Sinkronisasi -->
                <div class="px-4 py-2.5 border-b border-slate-800/80 bg-slate-900/60 flex items-center justify-between text-[11px]">
                    <span class="text-slate-400 font-medium">Status Sinkronisasi</span>
                    <span id="badge-koneksi" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                        <i class="fa-solid fa-circle text-[7px] mr-1 animate-pulse"></i>Aktif
                    </span>
                </div>

                <!-- MENU PETUGAS: INPUT SUHU, DIAGRAM GRAFIK, & RIWAYAT -->
                <nav class="p-3 space-y-1.5 flex-1">
                    <p class="px-3 pt-1 pb-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Menu Petugas</p>

                    <button type="button" onclick="pilihMenu('input-suhu')" data-menu="input-suhu"
                        class="sidebar-btn sidebar-link-active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-temperature-half w-4 text-center"></i>
                        <span>Input Suhu</span>
                    </button>

                    <button type="button" onclick="pilihMenu('diagram-grafik')" data-menu="diagram-grafik"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-chart-line w-4 text-center text-emerald-400"></i>
                        <span>Diagram Grafik</span>
                    </button>

                    <button type="button" onclick="pilihMenu('riwayat')" data-menu="riwayat"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-clock-rotate-left w-4 text-center text-cyan-400"></i>
                        <span>Riwayat</span>
                    </button>
                </nav>
            </div>

            <!-- Footer Sidebar -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 space-y-2.5">
                <button type="button" onclick="logoutUnit()"
                    class="w-full bg-rose-600/90 hover:bg-rose-600 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-sm">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Ganti Unit / Keluar</span>
                </button>
                <p class="text-[10px] text-center text-slate-500">UPTD RPH dan Pasar Hewan</p>
            </div>
        </aside>

        <!-- AREA KONTEN FULLSCREEN -->
        <div class="flex-1 flex flex-col min-w-0 bg-white">

            <!-- HEADER ATAS -->
            <header class="bg-gradient-to-r from-sky-900 via-sky-800 to-cyan-800 text-white sticky top-0 z-30 shadow-md">
                <div class="px-3.5 sm:px-6 py-3 flex items-center justify-between gap-2.5">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                        <!-- Tombol Buka / Tutup Sidebar -->
                        <button type="button" onclick="toggleSidebar()" title="Buka / Tutup Menu"
                            class="w-10 h-10 rounded-xl bg-white/15 hover:bg-white/25 border border-white/20 flex items-center justify-center transition-colors shrink-0 cursor-pointer">
                            <i class="fa-solid fa-bars text-base"></i>
                        </button>

                        <div class="min-w-0 flex-1">
                            <h1 class="text-[13px] sm:text-sm md:text-base font-black tracking-tight uppercase leading-snug break-words whitespace-normal">
                                Petugas Input Suhu Pendingin UPTD RPH dan Pasar Hewan
                            </h1>
                        </div>
                    </div>

                    <button type="button" onclick="logoutUnit()"
                        class="bg-white/15 hover:bg-white/25 border border-white/20 text-white text-[11px] font-bold px-3 py-2 rounded-xl transition-colors flex items-center gap-1.5 cursor-pointer shrink-0">
                        <i class="fa-solid fa-right-left"></i>
                        <span>Ganti Unit</span>
                    </button>
                </div>
            </header>

            <!-- KONTEN FULLSCREEN PER MENU -->
            <main class="flex-1 w-full bg-white flex flex-col">

                <!-- ==================== 1. MENU INPUT SUHU ==================== -->
                <section id="sec-input-suhu" class="menu-section flex-1 w-full flex flex-col">
                    <!-- BAR WAKTU & TANGGAL REALTIME -->
                    <div class="bg-gradient-to-r from-slate-900 via-sky-950 to-cyan-950 text-white px-4 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-sky-800/40">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-cyan-500/20 border border-cyan-400/30 flex items-center justify-center text-cyan-300 shrink-0">
                                <i class="fa-regular fa-clock text-lg"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-cyan-300 uppercase tracking-wider">Tanggal &amp; Waktu Real-Time (Otomatis)</p>
                                <p id="realtime-tanggal" class="text-xs sm:text-sm font-bold text-white mt-0.5">Memuat tanggal...</p>
                            </div>
                        </div>
                        <div class="sm:text-right bg-white/10 rounded-xl px-4 py-2 border border-white/15">
                            <p class="text-[10px] text-sky-200 uppercase font-bold tracking-wider">Jam Sekarang</p>
                            <p id="realtime-jam" class="text-lg sm:text-2xl font-black tracking-wider text-emerald-300 font-mono">00:00:00</p>
                        </div>
                    </div>

                    <!-- FORM INPUT SUHU PETUGAS -->
                    <div class="flex-1 w-full bg-white">
                        <div class="px-4 sm:px-6 py-4 border-b border-slate-100 bg-slate-50/70 flex items-center gap-2.5">
                            <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-temperature-half text-base"></i>
                            </div>
                            <div>
                                <h2 class="text-sm sm:text-base font-bold text-slate-800">Formulir Input Suhu Pendingin</h2>
                                <p id="form-subtitle-unit" class="text-[11px] text-slate-500">Pilih petugas, unit, jenis pendingin, suhu, dan foto bukti</p>
                            </div>
                        </div>

                        <form id="form-petugas-suhu" onsubmit="simpanInputPetugas(event)" class="p-4 sm:p-6 space-y-4 text-xs">
                            <!-- Pesan Error / Sukses -->
                            <div id="alert-error" class="hidden bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl flex items-start gap-2.5 font-medium">
                                <i class="fa-solid fa-circle-exclamation text-rose-500 text-base shrink-0 mt-0.5"></i>
                                <span id="alert-error-text">Terjadi kesalahan.</span>
                            </div>

                            <div id="alert-success" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-start gap-2.5 font-medium">
                                <i class="fa-solid fa-circle-check text-emerald-600 text-base shrink-0 mt-0.5"></i>
                                <div class="flex-1">
                                    <p class="font-bold">Laporan Suhu Berhasil Dikirim!</p>
                                    <p id="alert-success-text" class="text-[11px] text-emerald-700 mt-0.5">Data suhu dan foto bukti telah tersimpan.</p>
                                    <div class="flex flex-wrap items-center gap-3 mt-2">
                                        <button type="button" onclick="pilihMenu('riwayat')"
                                            class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-800 underline hover:text-emerald-950 cursor-pointer">
                                            <span>Lihat di Menu Riwayat</span>
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </button>
                                        <button type="button" onclick="pilihMenu('diagram-grafik')"
                                            class="inline-flex items-center gap-1.5 text-[11px] font-bold text-sky-800 underline hover:text-sky-950 cursor-pointer">
                                            <span>Lihat Diagram Grafik</span>
                                            <i class="fa-solid fa-chart-line"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- 1. Nama Petugas & Unit -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="inp-nama-petugas" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                                        Nama Petugas *
                                    </label>
                                    <select id="inp-nama-petugas" required
                                        class="w-full px-3.5 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-500 transition-all">
                                        <option value="">-- Pilih Nama Petugas --</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="inp-unit-petugas" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                                        Unit *
                                    </label>
                                    <select id="inp-unit-petugas" required
                                        class="w-full px-3.5 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-500 transition-all">
                                        <option value="">-- Pilih Unit --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- 2. Jenis Pendingin & Suhu Terukur -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="inp-jenis-ruangan" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                                        Jenis Pendingin *
                                    </label>
                                    <select id="inp-jenis-ruangan" required
                                        class="w-full px-3.5 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-500 transition-all">
                                        <option value="">-- Pilih Jenis Pendingin --</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="inp-suhu" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                                        Suhu Terukur (°C) *
                                    </label>
                                    <div class="relative">
                                        <input type="number" step="0.1" id="inp-suhu" required
                                            placeholder="Contoh: 2.5 atau -18.0"
                                            class="w-full pl-4 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-xl text-base font-black text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/25 focus:border-emerald-500 transition-all">
                                        <span class="absolute inset-y-0 right-0 pr-4 flex items-center text-sm font-bold text-slate-400">°C</span>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Ambil Foto Kamera HP / Upload Galeri -->
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                                    Foto Bukti Suhu (Kamera HP / Upload File Maks. 10 MB) *
                                </label>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <!-- Kamera Bawaan HP (Selalu Jalan di Android/iOS tanpa perlu HTTPS) -->
                                    <label for="inp-foto-kamera-native"
                                        class="w-full py-3 px-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-xs shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer">
                                        <i class="fa-solid fa-camera text-sm"></i>
                                        <span>Kamera HP</span>
                                    </label>

                                    <!-- Pilih File / Galeri -->
                                    <label for="inp-foto"
                                        class="w-full py-3 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-[0.99] text-slate-700 border border-slate-300 font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer">
                                        <i class="fa-solid fa-folder-open text-sm text-sky-700"></i>
                                        <span>Pilih File / Galeri</span>
                                    </label>
                                </div>

                                <!-- Input File menggunakan sr-only agar kompatibel di semua browser HP & iOS -->
                                <input type="file" id="inp-foto" accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                                    onchange="validasiDanPreviewFoto(event)" class="sr-only">
                                <input type="file" id="inp-foto-kamera-native" accept="image/*" capture="environment"
                                    onchange="validasiDanPreviewFoto(event)" class="sr-only">

                                <p id="info-foto" class="text-[11px] text-slate-400 mt-1.5">
                                    Gunakan <b>Kamera HP</b> atau <b>Pilih File / Galeri</b> (maks. <b>10 MB</b>, otomatis dioptimalkan agar pengiriman cepat &amp; tidak lag).
                                </p>

                                <!-- Preview Gambar -->
                                <div id="wrap-preview-foto" class="hidden mt-3 p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-3">
                                    <div id="wrap-avatar-preview" class="relative w-16 h-16 shrink-0">
                                        <img id="img-preview-foto" src="" alt="Preview Foto Suhu"
                                            class="w-16 h-16 rounded-full object-cover border-2 border-sky-300 bg-white cursor-pointer"
                                            onclick="bukaPopupFoto(this.src, document.getElementById('nama-file-foto').innerText, 'Preview Foto Bukti')">
                                        <div id="spinner-preview-foto" class="hidden absolute inset-0 rounded-full bg-white/85 border-2 border-sky-300 flex items-center justify-center text-sky-700">
                                            <i class="fa-solid fa-spinner fa-spin text-base"></i>
                                        </div>
                                    </div>
                                    <div class="min-w-0 flex-1">
