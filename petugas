        }

        function buatSvgDiagramGrafik(logsUnit, lineColor, unitNama, jenisNama) {
            const recentLogs = logsUnit.slice(-12);
            if (recentLogs.length === 0) {
                return `<div class="py-10 text-center text-xs text-slate-400">Belum ada rekaman suhu untuk ${esc(unitNama)} - ${esc(jenisNama)}.</div>`;
            }

            const W = 560;
            const H = 220;
            const padL = 46;
            const padR = 22;
            const padT = 28;
            const padB = 38;
            const plotW = W - padL - padR;
            const plotH = H - padT - padB;

            const suhuVals = recentLogs.map(l => Number(l.suhu));
            const minAll = Math.min(...suhuVals) - 2;
            const maxAll = Math.max(...suhuVals) + 2;
            const range = Math.max(1, maxAll - minAll);

            const toX = (idx) => recentLogs.length === 1
                ? padL + plotW / 2
                : padL + (idx / (recentLogs.length - 1)) * plotW;
            const toY = (val) => padT + ((maxAll - val) / range) * plotH;

            const points = recentLogs.map((l, idx) => ({
                x: toX(idx),
                y: toY(Number(l.suhu)),
                suhu: Number(l.suhu),
                waktu: l.waktu
            }));

            const polylinePoints = points.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");

            let gridLines = "";
            for (let i = 0; i <= 4; i++) {
                const v = minAll + (range * i) / 4;
                const y = toY(v);
                gridLines += `
                    <line x1="${padL}" y1="${y.toFixed(1)}" x2="${W - padR}" y2="${y.toFixed(1)}" stroke="#e2e8f0" stroke-dasharray="3,3" />
                    <text x="${padL - 7}" y="${(y + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="#64748b">${v.toFixed(1)}°</text>
                `;
            }

            const dotsHtml = points.map(p => {
                const dt = new Date(p.waktu);
                const lbl = isNaN(dt.getTime()) ? "-" : dt.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });
                return `
                    <g>
                        <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4.5" fill="${lineColor}" stroke="#ffffff" stroke-width="2" />
                        <text x="${p.x.toFixed(1)}" y="${(p.y - 9).toFixed(1)}" text-anchor="middle" font-size="9.5" font-weight="700" fill="${lineColor}">
                            ${p.suhu.toFixed(1)}°
                        </text>
                        <text x="${p.x.toFixed(1)}" y="${H - 10}" text-anchor="middle" font-size="9" fill="#64748b">
                            ${esc(lbl)}
                        </text>
                    </g>
                `;
            }).join("");

            return `
                <svg viewBox="0 0 ${W} ${H}" class="w-full h-auto select-none">
                    ${gridLines}
                    <polyline fill="none" stroke="${lineColor}" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" points="${polylinePoints}" />
                    ${dotsHtml}
                </svg>
            `;
        }

        function renderDiagramGrafik() {
            const container = document.getElementById("container-diagram-grafik");
            const unitTitleEl = document.getElementById("grafik-nama-unit");
            const countEl = document.getElementById("grafik-count-info");
            if (!container) return;

            const unitKey = String(unitLoginAktif || "").trim().toLowerCase();
            const tglFilter = document.getElementById("filter-grafik-tanggal")?.value || "";

            if (unitTitleEl) unitTitleEl.innerText = unitLoginAktif || "-";

            const unitPendinginList = dataUnits.filter(u =>
                String(u.kondisi || "Aktif").toLowerCase() !== "nonaktif" &&
                String(u.nama || "").trim().toLowerCase() === unitKey
            );

            if (countEl) {
                countEl.innerText = `Menampilkan ${unitPendinginList.length} jenis pendingin khusus unit ${unitLoginAktif || "-"}`;
            }

            if (unitPendinginList.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full py-10 text-center text-xs text-slate-400">
                        Belum ada jenis pendingin terdaftar untuk unit ${esc(unitLoginAktif)}.
                    </div>
                `;
                return;
            }

            container.innerHTML = unitPendinginList.map((u, idx) => {
                const pal = CHART_PALETTE[idx % CHART_PALETTE.length];
                const uNama = String(u.nama || "").trim();
                const uJenis = String(u.jenis || "Pendingin").trim();
                const uJenisKey = uJenis.toLowerCase();

                const logsJenis = dataLogs
                    .filter(l => {
                        const validSuhu = l.suhu !== null && l.suhu !== "" && !isNaN(Number(l.suhu));
                        if (!validSuhu) return false;
                        if (getLogUnitName(l).toLowerCase() !== unitKey) return false;
                        if (tglFilter && extractLogDateKey(l.waktu) !== tglFilter) return false;
                        if (l.unit_id && l.unit_id === u.id) return true;
                        return getLogJenisName(l).toLowerCase() === uJenisKey;
                    })
                    .sort((a, b) => new Date(a.waktu || 0) - new Date(b.waktu || 0));

                let suhuTerakhir = null;
                let suhuTerendah = null;
                let suhuTertinggi = null;

                if (logsJenis.length > 0) {
                    const nums = logsJenis.map(l => Number(l.suhu));
                    suhuTerakhir = Number(logsJenis[logsJenis.length - 1].suhu);
                    suhuTerendah = Math.min(...nums);
                    suhuTertinggi = Math.max(...nums);
                } else if (!tglFilter && u.suhu_terkini !== null && u.suhu_terkini !== "" && !isNaN(Number(u.suhu_terkini))) {
                    suhuTerakhir = Number(u.suhu_terkini);
                    suhuTerendah = Number(u.suhu_terkini);
                    suhuTertinggi = Number(u.suhu_terkini);
                }

                return `
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm space-y-2.5 min-w-0">
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-3 h-3 rounded-full ${pal.dot} shrink-0"></span>
                                <div class="min-w-0">
                                    <p class="text-xs font-black text-slate-900 uppercase leading-tight truncate">${esc(uNama)}</p>
                                    <p class="text-[11px] font-bold truncate" style="color:${pal.hex};">${esc(uJenis)}</p>
                                </div>
                            </div>
                            <span class="inline-block text-[10px] px-2.5 py-0.5 rounded-full border font-bold ${pal.badge} shrink-0">
                                Terakhir: ${suhuTerakhir !== null ? formatSuhu(suhuTerakhir) : "-"}
                            </span>
                        </div>

                        <div class="w-full overflow-hidden">
                            ${buatSvgDiagramGrafik(logsJenis, pal.hex, uNama, uJenis)}
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-600 pt-1.5 border-t border-slate-100">
                            <span>Suhu Terendah: <b class="text-sky-700">${suhuTerendah !== null ? formatSuhu(suhuTerendah) : "-"}</b></span>
                            <span>Suhu Tertinggi: <b class="text-rose-600">${suhuTertinggi !== null ? formatSuhu(suhuTertinggi) : "-"}</b></span>
                        </div>
                    </div>
                `;
            }).join("");
        }

        // ==================== TABEL RIWAYAT KHUSUS UNIT LOGIN ====================
        function getFilteredRiwayat() {
            const tglFilter = document.getElementById("filter-riwayat-tanggal")?.value || "";
            const kueri = (document.getElementById("cari-riwayat")?.value || "").toLowerCase();
            const unitKey = String(unitLoginAktif || "").trim().toLowerCase();

            return dataLogs.filter(item => {
                const logUnit = getLogUnitName(item).toLowerCase();
                const matchLoginUnit = !unitKey || logUnit === unitKey;
                const matchTgl = !tglFilter || String(item.waktu || "").startsWith(tglFilter);
                const teks = `${item.petugas || ""} ${item.unit_petugas || ""} ${item.nama_unit || ""} ${item.jenis_pendingin || ""}`.toLowerCase();
                return matchLoginUnit && matchTgl && teks.includes(kueri);
            });
        }

        function resetPageDanRenderRiwayat() {
            riwayatPage = 1;
            renderTabelRiwayat();
        }

        function gantiHalamanRiwayat(page) {
            riwayatPage = page;
            renderTabelRiwayat();
        }

        function renderTabelRiwayat() {
            const tbody = document.getElementById("tbody-riwayat");
            const pagEl = document.getElementById("pagination-riwayat");
            const countInfo = document.getElementById("riwayat-count-info");
            if (!tbody) return;

            const filtered = getFilteredRiwayat();
            countInfo.innerText = `${filtered.length} catatan suhu unit ${unitLoginAktif || ""}`;

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="border border-slate-300 text-center py-8 text-slate-400">
                            Belum ada riwayat pencatatan suhu untuk unit ${esc(unitLoginAktif)}.
                        </td>
                    </tr>
                `;
                pagEl.classList.add("hidden");
                pagEl.innerHTML = "";
                return;
            }

            const total = filtered.length;
            const totalPages = Math.max(1, Math.ceil(total / ITEMS_PER_PAGE));
            if (riwayatPage > totalPages) riwayatPage = totalPages;
            if (riwayatPage < 1) riwayatPage = 1;

            const startIdx = (riwayatPage - 1) * ITEMS_PER_PAGE;
            const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, total);
            const paged = filtered.slice(startIdx, endIdx);

            tbody.innerHTML = paged.map((item, idx) => {
                const nomor = startIdx + idx + 1;
                const unitObj = dataUnits.find(u => u.id === item.unit_id);
                const unitNama = getLogUnitName(item) || (unitObj ? unitObj.nama : "");
                const jenisPendingin = item.jenis_pendingin || (unitObj ? unitObj.jenis : "") || item.jenis_ruangan || "";
                const waktuSplit = formatTanggalJamSplit(item.waktu);

                const suhuCls = item.status === "Kritis" ? "text-rose-600" : (item.status === "Peringatan" ? "text-amber-600" : "text-sky-700");

                const judulPopup = `${unitNama}${jenisPendingin ? ` (${jenisPendingin})` : ""}`;
                const subinfoPopup = `${item.petugas || ""} • ${Number(item.suhu).toFixed(1)} °C • ${formatWaktuIndo(item.waktu)}`;

                const avatarHtml = item.foto
                    ? `<img src="${esc(item.foto)}" alt="Foto" loading="lazy" decoding="async"
                            onclick='bukaPopupFoto(${safeJsonAttr(item.foto)}, ${safeJsonAttr(judulPopup)}, ${safeJsonAttr(subinfoPopup)})'
                            title="Klik untuk memperbesar foto"
                            class="w-7 h-7 sm:w-10 sm:h-10 rounded-full object-cover border-2 border-sky-200 hover:border-sky-500 hover:scale-110 transition-all cursor-pointer mx-auto bg-white shadow-sm">`
                    : `<div title="Tidak ada foto"
                            class="w-7 h-7 sm:w-10 sm:h-10 rounded-full bg-slate-100 border border-slate-300 flex items-center justify-center text-slate-400 mx-auto">
                            <i class="fa-regular fa-image text-[10px] sm:text-xs"></i>
                       </div>`;

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="border border-slate-300 px-1 sm:px-3 py-2 sm:py-3 text-center font-bold text-slate-600 break-words">${nomor}</td>
                        <td class="border border-slate-300 px-1 sm:px-3.5 py-2 sm:py-3 font-medium text-slate-700 leading-tight break-words">
                            <span class="block font-semibold text-slate-800">${esc(waktuSplit.tgl)}</span>
                            <span class="block text-[9px] sm:text-[11px] text-slate-500">${esc(waktuSplit.jam)}</span>
                        </td>
                        <td class="border border-slate-300 px-1.5 sm:px-3.5 py-2 sm:py-3 font-bold text-slate-800 leading-tight break-words">${esc(item.petugas || "")}</td>
                        <td class="border border-slate-300 px-1.5 sm:px-4 py-2 sm:py-3 leading-tight break-words">
                            <p class="font-bold text-slate-900">${esc(unitNama)}</p>
                            <p class="text-[9px] sm:text-[11px] font-semibold text-sky-700 mt-0.5">${esc(jenisPendingin)}</p>
                        </td>
                        <td class="border border-slate-300 px-1 sm:px-3 py-2 sm:py-3 text-center font-black ${suhuCls} leading-tight break-words">
                            ${Number(item.suhu).toFixed(1)}<span class="text-[9px] sm:text-xs">°C</span>
                        </td>
                        <td class="border border-slate-300 px-1 sm:px-3 py-2 sm:py-3 text-center">${avatarHtml}</td>
                    </tr>
                `;
            }).join("");

            const pages = [];
            if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                pages.push(1);
                if (riwayatPage > 3) pages.push("...");
                for (let i = Math.max(2, riwayatPage - 1); i <= Math.min(totalPages - 1, riwayatPage + 1); i++) pages.push(i);
                if (riwayatPage < totalPages - 2) pages.push("...");
                pages.push(totalPages);
            }

            pagEl.className = "px-3 sm:px-4 py-3 border-t border-slate-200 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs";
            pagEl.innerHTML = `
                <p class="text-[11px] text-slate-500 font-medium text-center sm:text-left">
                    Menampilkan <b class="text-slate-700">${startIdx + 1}–${endIdx}</b> dari <b class="text-slate-700">${total}</b> catatan
                    <span class="text-slate-400">&bull; Hal ${riwayatPage}/${totalPages}</span>
                </p>
                <div class="flex items-center gap-1 flex-wrap justify-center">
                    <button type="button" onclick="gantiHalamanRiwayat(${riwayatPage - 1})" ${riwayatPage <= 1 ? "disabled" : ""}
                        class="h-[30px] px-2.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                    </button>
                    ${pages.map(p => p === "..."
                        ? `<span class="px-2 text-slate-400 select-none">...</span>`
                        : `<button type="button" onclick="gantiHalamanRiwayat(${p})" class="min-w-[30px] h-[30px] px-2 rounded-lg text-xs font-bold transition-colors cursor-pointer ${
                            p === riwayatPage ? "bg-sky-700 text-white shadow-sm" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-100"
                        }">${p}</button>`
                    ).join("")}
                    <button type="button" onclick="gantiHalamanRiwayat(${riwayatPage + 1})" ${riwayatPage >= totalPages ? "disabled" : ""}
                        class="h-[30px] px-2.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </button>
                </div>
            `;
        }

        // ==================== CETAK PDF RIWAYAT RAPI TANPA TERPOTONG ====================
        function cetakPdfRiwayat() {
            const filtered = getFilteredRiwayat();
            if (filtered.length === 0) {
                alert("Tidak ada data riwayat suhu untuk dicetak.");
                return;
            }

            const btn = document.getElementById("btn-cetak-pdf");
            const originalHtml = btn ? btn.innerHTML : "";
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Membuat PDF...</span>`;
            }

            try {
                if (window.jspdf && typeof window.jspdf.jsPDF === "function") {
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF({
                        orientation: "portrait",
                        unit: "mm",
                        format: "a4"
                    });

                    const pageWidth = doc.internal.pageSize.getWidth();
                    const pageHeight = doc.internal.pageSize.getHeight();
                    const marginX = 12;
                    const contentWidth = pageWidth - (marginX * 2);

                    const tglFilter = document.getElementById("filter-riwayat-tanggal")?.value || "";
                    const kueri = (document.getElementById("cari-riwayat")?.value || "").trim();
                    const waktuCetak = new Date().toLocaleString("id-ID", {
                        day: "2-digit",
                        month: "long",
                        year: "numeric",
                        hour: "2-digit",
                        minute: "2-digit"
                    }) + " WIB";

                    doc.setFillColor(7, 89, 133);
                    doc.roundedRect(marginX, 12, contentWidth, 21, 2.5, 2.5, "F");

                    doc.setTextColor(255, 255, 255);
                    doc.setFont("helvetica", "bold");
                    doc.setFontSize(12);
                    doc.text("LAPORAN RIWAYAT INPUT SUHU PENDINGIN", pageWidth / 2, 20, { align: "center" });

                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(9.5);
                    doc.setTextColor(224, 242, 254);
                    doc.text("UPTD RPH DAN PASAR HEWAN", pageWidth / 2, 27, { align: "center" });

                    const infoFilterTgl = tglFilter
                        ? new Date(tglFilter + "T00:00:00").toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" })
                        : "Semua Tanggal";
                    const infoCari = kueri ? ` | Kata Kunci: "${kueri}"` : "";
                    const filterLine = `Filter Tanggal: ${infoFilterTgl}${infoCari}`;

                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(8);
                    const wrappedFilter = doc.splitTextToSize(filterLine, contentWidth - 6);
                    const infoBoxHeight = 9.5 + (wrappedFilter.length * 4);

                    doc.setFillColor(248, 250, 252);
                    doc.setDrawColor(203, 213, 225);
                    doc.roundedRect(marginX, 36, contentWidth, infoBoxHeight, 1.5, 1.5, "FD");

                    doc.setFont("helvetica", "bold");
                    doc.setFontSize(8.5);
                    doc.setTextColor(30, 41, 59);
                    doc.text(`Unit: ${unitLoginAktif || "-"}`, marginX + 3, 41.5);
                    doc.text(`Total Catatan: ${filtered.length} data`, marginX + 58, 41.5);
                    doc.text(`Dicetak: ${waktuCetak}`, pageWidth - marginX - 3, 41.5, { align: "right" });

                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(8);
                    doc.setTextColor(71, 85, 105);
                    doc.text(wrappedFilter, marginX + 3, 47);

                    const tableStartY = 36 + infoBoxHeight + 4;

                    const hasAnyFoto = filtered.some(it => Boolean(it.foto));
                    const bodyRows = filtered.map((item, idx) => {
                        const unitObj = dataUnits.find(u => u.id === item.unit_id);
                        const unitNama = getLogUnitName(item) || (unitObj ? unitObj.nama : "-");
                        const jenisPendingin = item.jenis_pendingin || (unitObj ? unitObj.jenis : "") || item.jenis_ruangan || "-";
                        const dt = new Date(item.waktu || "");
                        const tglJam = isNaN(dt.getTime())
                            ? String(item.waktu || "-")
                            : `${dt.toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" })}\n${dt.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" })} WIB`;
                        const suhuNum = Number(item.suhu);
                        const suhuStr = isNaN(suhuNum) ? "-" : `${suhuNum.toFixed(1)} °C`;

                        return [
                            String(idx + 1),
                            tglJam,
                            String(item.petugas || "-"),
                            `${unitNama}\n${jenisPendingin}`,
                            suhuStr,
                            item.foto ? "" : "-"
                        ];
                    });

                    doc.autoTable({
                        startY: tableStartY,
                        tableWidth: contentWidth,
                        margin: { top: 14, right: marginX, bottom: 17, left: marginX },
                        head: [["No", "Tanggal & Waktu", "Nama Petugas", "Unit & Jenis Pendingin", "Suhu", "Foto"]],
                        body: bodyRows,
                        theme: "grid",
                        showHead: "everyPage",
                        rowPageBreak: "avoid",
                        styles: {
                            font: "helvetica",
                            fontSize: 8.5,
                            cellPadding: { top: 2.5, right: 2.5, bottom: 2.5, left: 2.5 },
                            valign: "middle",
                            textColor: [30, 41, 59],
                            lineColor: [148, 163, 184],
                            lineWidth: 0.25,
                            overflow: "linebreak",
                            minCellHeight: hasAnyFoto ? 15.5 : 9
                        },
                        headStyles: {
                            fillColor: [7, 89, 133],
                            textColor: [255, 255, 255],
                            fontStyle: "bold",
                            fontSize: 8.5,
                            halign: "center",
                            valign: "middle",
                            minCellHeight: 9
                        },
                        alternateRowStyles: {
                            fillColor: [248, 250, 252]
                        },
                        columnStyles: {
                            0: { cellWidth: 11, halign: "center", fontStyle: "bold" },
                            1: { cellWidth: 34, halign: "left" },
                            2: { cellWidth: 38, halign: "left", fontStyle: "bold" },
                            3: { cellWidth: 57, halign: "left" },
                            4: { cellWidth: 22, halign: "center", fontStyle: "bold" },
                            5: { cellWidth: 24, halign: "center" }
                        },
                        didParseCell: function (data) {
                            if (data.section === "body" && data.column.index === 4) {
                                data.cell.styles.textColor = [3, 105, 161];
                            }
                        },
                        didDrawCell: function (data) {
                            if (data.section === "body" && data.column.index === 5) {
                                const item = filtered[data.row.index];
                                if (item && item.foto && typeof item.foto === "string" && item.foto.startsWith("data:image/")) {
                                    try {
                                        const fmt = item.foto.startsWith("data:image/png") ? "PNG" : "JPEG";
                                        const maxW = Math.max(4, data.cell.width - 4);
                                        const maxH = Math.max(4, data.cell.height - 3);
                                        let drawW = Math.min(12, maxW, maxH);
                                        let drawH = drawW;

                                        if (typeof doc.getImageProperties === "function") {
                                            const props = doc.getImageProperties(item.foto);
                                            if (props && props.width > 0 && props.height > 0) {
                                                const ratio = Math.min(Math.min(13, maxW) / props.width, Math.min(13, maxH) / props.height);
                                                drawW = props.width * ratio;
                                                drawH = props.height * ratio;
                                            }
                                        }

                                        if (drawW > 2 && drawH > 2) {
                                            const x = data.cell.x + (data.cell.width - drawW) / 2;
                                            const y = data.cell.y + (data.cell.height - drawH) / 2;
                                            doc.addImage(item.foto, fmt, x, y, drawW, drawH);
                                        }
                                    } catch (imgErr) {}
                                }
                            }
                        }
                    });

                    const totalPages = doc.internal.getNumberOfPages();
                    for (let i = 1; i <= totalPages; i++) {
                        doc.setPage(i);
                        doc.setDrawColor(226, 232, 240);
                        doc.line(marginX, pageHeight - 12, pageWidth - marginX, pageHeight - 12);

                        doc.setFont("helvetica", "normal");
                        doc.setFontSize(7.5);
                        doc.setTextColor(100, 116, 139);
                        doc.text("Petugas Input Suhu Pendingin • UPTD RPH dan Pasar Hewan", marginX, pageHeight - 7.5);
                        doc.text(`Halaman ${i} dari ${totalPages}`, pageWidth - marginX, pageHeight - 7.5, { align: "right" });
                    }

                    const safeUnit = (unitLoginAktif || "Unit").replace(/[^a-zA-Z0-9_-]/g, "_");
                    const now = new Date();
                    const pad = n => String(n).padStart(2, "0");
                    const stamp = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}`;
                    doc.save(`Riwayat_Suhu_${safeUnit}_${stamp}.pdf`);
                } else {
                    cetakPdfFallbackPrint(filtered);
                }
            } catch (err) {
                alert("Gagal membuat PDF: " + err.message);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }
        }

        function cetakPdfFallbackPrint(filtered) {
            const win = window.open("", "_blank");
            if (!win) {
                alert("Pop-up diblokir browser. Izinkan pop-up untuk mencetak PDF.");
                return;
            }
            const rowsHtml = filtered.map((item, idx) => {
                const unitObj = dataUnits.find(u => u.id === item.unit_id);
                const unitNama = getLogUnitName(item) || (unitObj ? unitObj.nama : "-");
                const jenisPendingin = item.jenis_pendingin || (unitObj ? unitObj.jenis : "") || item.jenis_ruangan || "-";
                const suhuNum = Number(item.suhu);
                const suhuStr = isNaN(suhuNum) ? "-" : `${suhuNum.toFixed(1)} °C`;
                const fotoTag = item.foto
                    ? `<img src="${esc(item.foto)}" style="width:36px;height:36px;object-fit:cover;border-radius:4px;border:1px solid #cbd5e1;display:block;margin:0 auto;">`
                    : `-`;
                return `
                    <tr>
                        <td style="text-align:center;">${idx + 1}</td>
                        <td>${formatWaktuIndo(item.waktu)}</td>
                        <td><b>${esc(item.petugas || "-")}</b></td>
                        <td><b>${esc(unitNama)}</b><br><small>${esc(jenisPendingin)}</small></td>
                        <td style="text-align:center;color:#0369a1;"><b>${suhuStr}</b></td>
                        <td style="text-align:center;">${fotoTag}</td>
                    </tr>
                `;
            }).join("");

            win.document.write(`
                <!DOCTYPE html>
                <html lang="id">
