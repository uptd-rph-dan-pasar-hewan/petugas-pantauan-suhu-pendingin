                    btn.classList.add("sidebar-link-active");
                    btn.classList.remove("text-slate-300", "hover:bg-slate-800");
                } else {
                    btn.classList.remove("sidebar-link-active");
                    btn.classList.add("text-slate-300", "hover:bg-slate-800");
                }
            });

            document.querySelectorAll(".menu-section").forEach(el => el.classList.add("hidden"));
            const target = document.getElementById("sec-" + menu);
            if (target) target.classList.remove("hidden");

            if (menu === "riwayat") {
                renderTabelRiwayat();
            } else if (menu === "diagram-grafik") {
                renderDiagramGrafik();
            }
            if (window.innerWidth < 1024) {
                setSidebar(false);
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // ==================== NOTIFIKASI ANIMASI DATA TERKIRIM ====================
        function tampilkanNotifTerkirim(detailText) {
            const modal = document.getElementById("modal-notif-terkirim");
            const card = document.getElementById("card-notif-terkirim");
            const detailEl = document.getElementById("notif-terkirim-detail");
            const circle = document.getElementById("svg-notif-circle");
            const check = document.getElementById("svg-notif-check");
            const prog = document.getElementById("notif-progress-bar");
            if (!modal || !card) return;

            clearTimeout(notifTimer);
            if (detailEl) detailEl.innerText = detailText || "Laporan suhu dan foto bukti telah tersimpan.";

            card.classList.remove("anim-notif-in", "anim-notif-out");
            circle.classList.remove("svg-check-circle");
            check.classList.remove("svg-check-mark");
            prog.classList.remove("anim-progress-bar");
            void card.offsetWidth;

            card.classList.add("anim-notif-in");
            circle.classList.add("svg-check-circle");
            check.classList.add("svg-check-mark");
            prog.classList.add("anim-progress-bar");

            modal.classList.remove("hidden");

            notifTimer = setTimeout(() => {
                tutupNotifTerkirim();
            }, 3500);
        }

        function tutupNotifTerkirim() {
            const modal = document.getElementById("modal-notif-terkirim");
            const card = document.getElementById("card-notif-terkirim");
            if (!modal || modal.classList.contains("hidden")) return;

            clearTimeout(notifTimer);
            card.classList.remove("anim-notif-in");
            card.classList.add("anim-notif-out");

            setTimeout(() => {
                modal.classList.add("hidden");
                card.classList.remove("anim-notif-out");
            }, 220);
        }

        // ==================== DATA DEFAULT ====================
        function getDefaultUnits() {
            return [
                { id: "unit_1", nama: "RPH", jenis: "Chiller", lokasi: "Area RPH", suhu_min: 0, suhu_max: 4, suhu_terkini: 2.3, kondisi: "Aktif" },
                { id: "unit_2", nama: "RPH", jenis: "Freezer", lokasi: "Area RPH", suhu_min: -22, suhu_max: -16, suhu_terkini: -18.5, kondisi: "Aktif" },
                { id: "unit_3", nama: "RPU", jenis: "Cold Storage", lokasi: "Area RPU", suhu_min: 2, suhu_max: 6, suhu_terkini: 3.2, kondisi: "Aktif" },
                { id: "unit_4", nama: "RPU", jenis: "ABF", lokasi: "Area RPU", suhu_min: -25, suhu_max: -18, suhu_terkini: -20.8, kondisi: "Aktif" }
            ];
        }

        function getDefaultPetugas() {
            return [
                { id: "ptg_1", nama: "Budi Santoso", unit: "RPH" },
                { id: "ptg_2", nama: "Lukman", unit: "RPU" }
            ];
        }

        // ==================== HELPER ====================
        function esc(str) {
            if (str === null || str === undefined) return "";
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function safeJsonAttr(val) {
            return JSON.stringify(val || "")
                .replace(/'/g, "\\u0027")
                .replace(/</g, "\\u003c")
                .replace(/>/g, "\\u003e");
        }

        function getUniqueUnitNames() {
            const list = [];
            const seen = new Set();
            dataUnits.forEach(u => {
                if (String(u.kondisi || "Aktif").toLowerCase() === "nonaktif") return;
                const nama = String(u.nama || "").trim();
                const key = nama.toLowerCase();
                if (nama && !seen.has(key)) {
                    seen.add(key);
                    list.push(nama);
                }
            });
            return list;
        }

        function getUnitPetugas(p) {
            if (p.unit && String(p.unit).trim() !== "") return String(p.unit).trim();
            if (p.unit_id) {
                const u = dataUnits.find(x => x.id === p.unit_id);
                if (u && u.nama) return String(u.nama).trim();
            }
            return "";
        }

        function getLogUnitName(item) {
            if (item.unit_id) {
                const found = dataUnits.find(u => u.id === item.unit_id);
                if (found && found.nama) return String(found.nama).trim();
            }
            if (item.unit_petugas && String(item.unit_petugas).trim() !== "") {
                return String(item.unit_petugas).trim();
            }
            return String(item.nama_unit || "").replace(/\s*\([^)]*\)\s*$/, "").trim();
        }

        function getLogJenisName(item) {
            if (item.jenis_pendingin) return String(item.jenis_pendingin).trim();
            if (item.jenis_ruangan) return String(item.jenis_ruangan).trim();
            if (item.unit_id) {
                const found = dataUnits.find(u => u.id === item.unit_id);
                if (found && found.jenis) return String(found.jenis).trim();
            }
            return "";
        }

        function extractLogDateKey(waktuStr) {
            if (!waktuStr) return "";
            const s = String(waktuStr);
            if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
            const dt = new Date(s);
            if (isNaN(dt.getTime())) return "";
            const pad = n => String(n).padStart(2, "0");
            return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
        }

        function getNowDateTimeLocal() {
            const d = new Date();
            const pad = n => String(n).padStart(2, "0");
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
        }

        function formatWaktuIndo(waktuStr) {
            if (!waktuStr) return "";
            const dt = new Date(waktuStr);
            if (isNaN(dt.getTime())) return esc(waktuStr);
            return dt.toLocaleString("id-ID", {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function formatTanggalJamSplit(waktuStr) {
            if (!waktuStr) return { tgl: "", jam: "" };
            const dt = new Date(waktuStr);
            if (isNaN(dt.getTime())) return { tgl: esc(waktuStr), jam: "" };
            const tgl = dt.toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "2-digit" });
            const jam = dt.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });
            return { tgl, jam };
        }

        function formatSuhu(val) {
            if (val === "" || val === null || val === undefined) return "-";
            const num = Number(val);
            if (isNaN(num)) return "-";
            return `${num.toFixed(1)} °C`;
        }

        function evaluasiStatusSuhu(suhu, minVal, maxVal) {
            const t = Number(suhu);
            const min = Number(minVal);
            const max = Number(maxVal);
            if (isNaN(t) || isNaN(min) || isNaN(max)) {
                return { status: "Normal", keterangan: "Suhu tercatat" };
            }
            if (t > max) {
                return { status: "Kritis", keterangan: `Di atas batas (+${(t - max).toFixed(1)}°C)` };
            }
            if (t < min) {
                return { status: "Kritis", keterangan: `Di bawah batas (-${(min - t).toFixed(1)}°C)` };
            }
            const rentang = Math.max(0.5, max - min);
            const margin = Math.min(0.8, rentang * 0.15);
            if (t >= max - margin || t <= min + margin) {
                return { status: "Peringatan", keterangan: "Mendekati ambang batas" };
            }
            return { status: "Normal", keterangan: "Suhu dalam batas aman" };
        }

