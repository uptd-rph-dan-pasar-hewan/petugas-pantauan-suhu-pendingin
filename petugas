                suhu: suhu,
                suhu_min: unit.suhu_min,
                suhu_max: unit.suhu_max,
                status: ev.status,
                waktu: waktuSekarang,
                petugas_id: ptg.id,
                petugas: ptg.nama,
                unit_petugas: unitDipilih,
                catatan: catatanLengkap,
