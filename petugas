                </body>
                </html>
            `);
            win.document.close();
        }

        // ==================== POP-UP FOTO ====================
        function bukaPopupFoto(src, judul, subinfo) {
            if (!src) return;
            document.getElementById("popup-img").src = src;
            document.getElementById("popup-judul").innerText = judul || "Foto Bukti Suhu";
            document.getElementById("popup-subinfo").innerText = subinfo || "";
            document.getElementById("modal-popup-foto").classList.remove("hidden");
        }

        function tutupPopupFoto() {
            document.getElementById("modal-popup-foto").classList.add("hidden");
            document.getElementById("popup-img").src = "";
        }

        // ==================== INISIALISASI ====================
        window.addEventListener("DOMContentLoaded", () => {
            sidebarTerbuka = window.innerWidth >= 1024;
            terapkanStateSidebar();
            updateWaktuRealtime();
            setInterval(updateWaktuRealtime, 1000);
            aktifkanSync();
        });
    </script>
