                if (menuAktif === "riwayat") renderTabelRiwayat();

                tampilkanNotifTerkirim(ringkasan);
            } catch (err) {
                errText.innerText = "Gagal mengirim ke server: " + err.message;
                errBox.classList.remove("hidden");
