            if (!database) {
                updateBadgeKoneksi(false);
                return;
            }

            database.ref("pantauan_suhu_pendingin/petugas").on("value", snap => {
                updateBadgeKoneksi(true);
                const val = snap.val();
                if (val) {
                    dataPetugas = Object.entries(val).map(([k, v]) => ({ ...v, id: v.id || k }));
                    simpanLokal();
                    if (unitLoginAktif) isiSemuaDropdownTerdaftar();
                }
            }, () => updateBadgeKoneksi(false));

            database.ref("pantauan_suhu_pendingin/units").on("value", snap => {
                updateBadgeKoneksi(true);
                const val = snap.val();
                if (val) {
                    dataUnits = Object.entries(val).map(([k, v]) => ({ ...v, id: v.id || k }));
                    simpanLokal();
                    renderLoginUnits();
                    if (unitLoginAktif) {
                        isiSemuaDropdownTerdaftar();
                        if (menuAktif === "diagram-grafik") renderDiagramGrafik();
                        if (menuAktif === "riwayat") renderTabelRiwayat();
