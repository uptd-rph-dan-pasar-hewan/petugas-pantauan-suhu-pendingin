            muatLokal();
            renderLoginUnits();

            try {
                const savedUnit = sessionStorage.getItem(SESSION_KEY_UNIT);
                const validUnits = getUniqueUnitNames();
                if (savedUnit && validUnits.some(u => u.toLowerCase() === savedUnit.toLowerCase())) {
                    const matched = validUnits.find(u => u.toLowerCase() === savedUnit.toLowerCase());
                    loginUnit(matched);
                }
