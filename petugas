        function toggleSidebar() {
            sidebarTerbuka = !sidebarTerbuka;
            terapkanStateSidebar();
        }

        function terapkanStateSidebar() {
            const sidebar = document.getElementById("app-sidebar");
            const overlay = document.getElementById("sidebar-overlay");
            const isDesktop = window.innerWidth >= 1024;

            if (isDesktop) {
                overlay.classList.add("hidden");
                sidebar.classList.remove("translate-x-0", "-translate-x-full");
                if (sidebarTerbuka) {
                    sidebar.classList.remove("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none");
                    sidebar.classList.add("lg:ml-0", "lg:opacity-100");
                } else {
                    sidebar.classList.remove("lg:ml-0", "lg:opacity-100");
                    sidebar.classList.add("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none");
                }
            } else {
                sidebar.classList.remove("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none", "lg:ml-0", "lg:opacity-100");
                if (sidebarTerbuka) {
                    sidebar.classList.remove("-translate-x-full");
                    sidebar.classList.add("translate-x-0");
                    overlay.classList.remove("hidden");
                } else {
                    sidebar.classList.remove("translate-x-0");
                    sidebar.classList.add("-translate-x-full");
                    overlay.classList.add("hidden");
                }
            }
        }

        window.addEventListener("resize", () => {
            const isDesktopNow = window.innerWidth >= 1024;
            if (isDesktopNow !== lastIsDesktop) {
                lastIsDesktop = isDesktopNow;
                sidebarTerbuka = isDesktopNow;
                terapkanStateSidebar();
            }
