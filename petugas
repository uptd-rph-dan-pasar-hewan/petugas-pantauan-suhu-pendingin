                errText.innerText = "Mohon ambil foto lewat Kamera HP atau pilih file foto bukti.";
                errBox.classList.remove("hidden");
                return;
            }

            const suhu = parseFloat(suhuStr);
            const ev = evaluasiStatusSuhu(suhu, unit.suhu_min, unit.suhu_max);
            const waktuSekarang = getNowDateTimeLocal();
            const logId = "log_" + Date.now();
            const jenisPendingin = unit.jenis || "Pendingin";

            const catatanLengkap = catatanUser || `${unitDipilih} • ${jenisPendingin}`;

            const logBaru = {
                id: logId,
                unit_id: unit.id,
                nama_unit: unit.nama,
