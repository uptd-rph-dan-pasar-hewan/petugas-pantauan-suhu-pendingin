                foto_nama: fotoTerpilihNama
            };

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim Data...</span>`;

            try {
                dataLogs.unshift(logBaru);
                unit.suhu_terkini = suhu;
                unit.updated_at = waktuSekarang;
                unit.petugas_terakhir = ptg.nama;
                simpanLokal();

                if (database) {
                    await Promise.all([
                        database.ref("pantauan_suhu_pendingin/logs/" + logId).set(logBaru),
                        database.ref("pantauan_suhu_pendingin/units/" + unit.id).set(unit)
                    ]);
                }

                const ringkasan = `${ptg.nama} • ${unitDipilih} (${jenisPendingin}): ${suhu.toFixed(1)} °C pada ${formatWaktuIndo(waktuSekarang)}.`;
                okText.innerText = ringkasan;
