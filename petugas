        // ==================== UPLOAD & KOMPRESI FOTO CEPAT TANPA LAG ====================
        function hitungDimensiTarget(srcW, srcH, maxDim) {
            let w = srcW;
            let h = srcH;
            if (w > maxDim || h > maxDim) {
                if (w > h) {
                    h = Math.max(1, Math.round((h * maxDim) / w));
                    w = maxDim;
                } else {
                    w = Math.max(1, Math.round((w * maxDim) / h));
                    h = maxDim;
                }
            }
            return { w, h };
        }

        async function muatGambarTerResize(file, maxDim) {
            // Prioritas 1: createImageBitmap dengan resize bawaan browser (paling cepat & hemat RAM di Android/Chrome)
            if (typeof createImageBitmap === "function") {
                try {
                    const infoBitmap = await createImageBitmap(file);
                    const { w, h } = hitungDimensiTarget(infoBitmap.width, infoBitmap.height, maxDim);
                    infoBitmap.close();

                    try {
                        const resizedBitmap = await createImageBitmap(file, {
                            resizeWidth: w,
                            resizeHeight: h,
                            resizeQuality: "medium"
                        });
                        return { source: resizedBitmap, w, h, cleanup: () => resizedBitmap.close() };
                    } catch (optErr) {
                        const fallbackBitmap = await createImageBitmap(file);
                        return { source: fallbackBitmap, w, h, cleanup: () => fallbackBitmap.close() };
                    }
                } catch (bmErr) {
                    // Lanjut ke fallback ObjectURL
                }
            }

            // Fallback: URL.createObjectURL (tetap jauh lebih hemat RAM dibanding FileReader.readAsDataURL)
            const objectUrl = URL.createObjectURL(file);
            try {
                const img = await new Promise((resolve, reject) => {
                    const el = new Image();
                    el.onload = () => resolve(el);
                    el.onerror = reject;
                    el.src = objectUrl;
                });
                const { w, h } = hitungDimensiTarget(img.naturalWidth || img.width, img.naturalHeight || img.height, maxDim);
                return { source: img, w, h, cleanup: () => URL.revokeObjectURL(objectUrl) };
            } catch (imgErr) {
                URL.revokeObjectURL(objectUrl);
                throw imgErr;
            }
        }

        async function validasiDanPreviewFoto(event) {
            const input = event.target;
            const file = input.files && input.files[0];
            const errBox = document.getElementById("alert-error");
            const errText = document.getElementById("alert-error-text");
            const btnKirim = document.getElementById("btn-kirim-suhu");
            const spinnerEl = document.getElementById("spinner-preview-foto");

            errBox.classList.add("hidden");
            if (!file) return;

            const isFromNativeCam = input.id === "inp-foto-kamera-native";
            const ext = (file.name.split(".").pop() || "").toLowerCase();
            const allowedExt = ["jpg", "jpeg", "png"];
            const allowedMime = ["image/jpeg", "image/png"];
            const isImageFile = file.type && file.type.startsWith("image/");

            if (!isFromNativeCam && !allowedExt.includes(ext) && !allowedMime.includes(file.type)) {
                input.value = "";
                hapusPilihanFoto();
                errText.innerText = "Format foto harus JPG, JPEG, atau PNG.";
                errBox.classList.remove("hidden");
                return;
            }
            if (isFromNativeCam && !isImageFile && !["jpg", "jpeg", "png", "webp", "heic"].includes(ext)) {
                input.value = "";
                hapusPilihanFoto();
                errText.innerText = "File yang diambil bukan format gambar.";
                errBox.classList.remove("hidden");
                return;
            }

            if (file.size > MAX_FILE_SIZE_BYTES) {
                const mb = (file.size / (1024 * 1024)).toFixed(2);
                input.value = "";
                hapusPilihanFoto();
                errText.innerText = `Ukuran foto (${mb} MB) melebihi batas maksimal 10 MB.`;
                errBox.classList.remove("hidden");
                return;
            }

            sedangKompresFoto = true;
            fotoTerpilihDataUrl = "";
            if (btnKirim) btnKirim.disabled = true;
            document.getElementById("wrap-preview-foto").classList.remove("hidden");
            if (spinnerEl) spinnerEl.classList.remove("hidden");
            document.getElementById("nama-file-foto").innerText = file.name || "Foto_Kamera.jpg";
            document.getElementById("ukuran-file-foto").innerText = "Mengoptimalkan foto agar cepat dikirim...";

            let loaded = null;
            try {
                // Beri kesempatan 1 frame agar UI spinner tampil sebelum draw canvas
                await new Promise(r => requestAnimationFrame(r));

                loaded = await muatGambarTerResize(file, MAX_FOTO_DIM);

                const canvas = document.createElement("canvas");
                canvas.width = loaded.w;
                canvas.height = loaded.h;
                const ctx = canvas.getContext("2d", { alpha: false });
                ctx.fillStyle = "#ffffff";
                ctx.fillRect(0, 0, loaded.w, loaded.h);
                ctx.drawImage(loaded.source, 0, 0, loaded.w, loaded.h);

                loaded.cleanup();
                loaded = null;

                // Selalu konversi ke JPEG agar PNG besar tidak membengkak menjadi 1-2 MB
                let quality = 0.72;
                let dataUrl = canvas.toDataURL("image/jpeg", quality);
                while (dataUrl.length > TARGET_BASE64_LEN && quality > 0.45) {
                    quality -= 0.1;
                    dataUrl = canvas.toDataURL("image/jpeg", quality);
                }

                // Bebaskan buffer canvas segera
                canvas.width = 0;
                canvas.height = 0;

                fotoTerpilihDataUrl = dataUrl;
                fotoTerpilihNama = file.name || "Foto_Kamera.jpg";

                const sizeAsli = file.size >= 1024 * 1024
                    ? `${(file.size / (1024 * 1024)).toFixed(2)} MB`
                    : `${Math.round(file.size / 1024)} KB`;
                const kbHasil = Math.round((dataUrl.length * 0.75) / 1024);

                document.getElementById("img-preview-foto").src = fotoTerpilihDataUrl;
                document.getElementById("nama-file-foto").innerText = fotoTerpilihNama;
                document.getElementById("ukuran-file-foto").innerText = `Asli: ${sizeAsli} → Dioptimalkan: ${kbHasil} KB (Siap dikirim)`;
            } catch (err) {
                if (loaded && typeof loaded.cleanup === "function") loaded.cleanup();
                hapusPilihanFoto();
                errText.innerText = "File gambar tidak dapat dibaca.";
                errBox.classList.remove("hidden");
            } finally {
                sedangKompresFoto = false;
                if (spinnerEl) spinnerEl.classList.add("hidden");
                if (btnKirim) btnKirim.disabled = false;
            }
        }

