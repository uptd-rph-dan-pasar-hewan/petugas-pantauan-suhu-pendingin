                }
            }, () => updateBadgeKoneksi(false));

            // Batasi 100 data log terbaru agar HP tidak mendownload puluhan MB foto lama sekaligus
            database.ref("pantauan_suhu_pendingin/logs")
                .orderByChild("waktu")
                .limitToLast(FIREBASE_LOG_LIMIT)
                .on("value", snap => {
                    const val = snap.val();
                    if (val) {
                        dataLogs = Object.entries(val).map(([k, v]) => ({ ...v, id: v.id || k }));
                        dataLogs.sort((a, b) => new Date(b.waktu || 0) - new Date(a.waktu || 0));
                    } else {
                        dataLogs = [];
                    }
                    simpanLokal();
                    if (unitLoginAktif) {
                        // Render hanya pada menu yang sedang dibuka agar main thread tidak lag
                        if (menuAktif === "diagram-grafik") renderDiagramGrafik();
                        if (menuAktif === "riwayat") renderTabelRiwayat();
                    }
                }, () => {});

            database.ref("pantauan_suhu_pendingin/settings").on("value", snap => {
                const val = snap.val();
                if (val && val.logo) {
                    document.getElementById("sidebar-logo").src = val.logo;
                    document.getElementById("login-logo").src = val.logo;
                }
            }, () => {});
        }

